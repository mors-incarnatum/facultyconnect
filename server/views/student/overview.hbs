<div class="page-head" style="display: flex; gap: 16px; align-items: center">
    {{> avatar person=user size="lg"}}
    <div>
        <h1 style="margin: 0">
            {{greeting}}, {{firstName user.name}}
            {{#if user.pronouns}}<span class="profile-pronouns" style="margin-left: 8px; font-size: 13px; font-weight: 500">{{user.pronouns}}</span>{{/if}}
        </h1>
        <p style="margin: 4px 0 0">
            {{#each statusCounts}}{{count}} {{status}}{{#unless @last}} · {{/unless}}{{/each}}.
            <a href="/student/appointments">View every status in My appointments.</a>
        </p>
    </div>
</div>

<div class="overview-grid student-overview-grid">
    <section>
        <h2 class="section-title">Upcoming and ongoing consultations</h2>
        <div class="overview-section-content">
            {{#each upcoming}}
            <div class="card upcoming-card">
                {{> badge status=status}}
                <div style="display: flex; gap: 12px; align-items: center; margin: 12px 0 8px">
                    {{> avatar person=faculty size="md"}}
                    <div>
                        <h3 style="margin: 0; font-size: 18px">{{faculty.name}}</h3>
                        <div class="muted small">{{faculty.rank}} · {{faculty.department}}</div>
                    </div>
                </div>
                <p class="when">{{fmtShort slot.date}} · {{fmtRange slot.start slot.end}}</p>
                <p class="muted">{{subject}}{{#if topic}} · {{topic}}{{/if}}</p>
                <a class="btn block" href="/student/appointments?id={{id}}">View appointment →</a>
            </div>
            {{else}}
            <div class="card empty">
                <h3>Nothing scheduled</h3>
                <p class="muted">Find a faculty member to request your next consultation.</p>
            </div>
            {{/each}}
            <p style="text-align: center; margin-top: 20px">
                <a href="/student/appointments">All appointments →</a>
            </p>
        </div>
    </section>
    <section>
        <h2 class="section-title">Your week at a glance</h2>
        {{!-- BATCH 2C: replace this placeholder card with the week calendar partial.
              The controller already passes `week` (see viewdata.buildWeek) for it. --}}
        <div class="card overview-calendar">
            <div class="notice">The week calendar for {{week.weekLabel}} is added in a later batch. Until then, use Find faculty to see open times.</div>
            <a class="btn" href="/student/faculty">Find faculty →</a>
        </div>
    </section>
</div>
