{
  "name": "facultyconnect",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n client,server \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "node --test client/src/state/availability.test.js client/src/state/autoDecline.test.js client/src/services/services.test.js client/src/data/initialData.test.js",
    "test:browser": "node tools/verify-faculty.cjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
